# Copy this file to .env and replace placeholders before local Docker use.
# .env is ignored by Git and must never be committed.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:28080

Config__Dir=/config
Data__DatabasePath=/config/musicsync.db
Library__Root=/music
Library__StagingDirectory=/music/.musicsync-staging

Tools__Ffmpeg=/usr/bin/ffmpeg
Tools__Ffprobe=/usr/bin/ffprobe
Tools__YtDlp=/usr/local/bin/yt-dlp

MusicBrainz__UserAgent=MusicSync/0.1 (https://github.com/ismabellmann/musicsearcher)
ListenBrainz__Token=

Auth__SecureCookies=false
Auth__SessionHours=168
Playlist__MaxTracks=100
Playlist__MaxCandidates=10
